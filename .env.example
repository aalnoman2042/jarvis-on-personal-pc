# Copy this file to ".env" and fill in what you need.

# ---- Which brain to use ----
# You can also switch this any time from the Brain dropdown in the Jarvis window.
# gemini = free, cloud   | groq   = free, fastest cloud
# ollama = free, offline, runs on this PC (run install_local_llm.bat first)
# claude = paid, smartest | free = offline rule-based, no AI
VONDO_BRAIN=gemini

# ---- Free brain keys (only the one for your chosen VONDO_BRAIN is required) ----
# Google Gemini free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Local brain: no key, no internet, no limits ----
# Install with install_local_llm.bat. qwen2.5:3b is the best fit for a normal
# CPU; use qwen2.5:7b if you have a fast machine and don't mind waiting longer.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://127.0.0.1:11434

# ---- Paid brain (keep for later) ----
# Anthropic Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# ---- Personality ----
ASSISTANT_NAME=Vondo
USER_TITLE=sir

# ---- Listening ----
# wake = only respond after the wake word | continuous = respond to everything
LISTEN_MODE=wake
WAKE_WORD=hey vondo

# ---- Voice ----
# Substring of a Windows voice name (e.g. David, Zira). Blank = system default.
TTS_VOICE=
TTS_RATE=175

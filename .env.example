# Copy this file to ".env" and fill in what you need.

# ---- Which brain to use ----
# You can also switch this any time from the Brain dropdown in the Jarvis window.
# auto   = RECOMMENDED. Tries Groq, then the local model, then Gemini, then the
#          offline rules. Groq does the work while its free tier lasts, so your
#          PC stays idle; a brain that fails is skipped for a while so it never
#          slows down later questions.
# gemini = free, cloud   | groq   = free, fastest cloud
# ollama = free, offline, runs on this PC (run install_local_llm.bat first)
# claude = paid, smartest | free = offline rule-based, no AI
VONDO_BRAIN=auto

# ---- Free brain keys (only the one for your chosen VONDO_BRAIN is required) ----
# Google Gemini free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Local brain: no key, no internet, no limits ----
# Install with install_local_llm.bat. qwen2.5:3b is the best fit for a normal
# CPU; use qwen2.5:7b if you have a fast machine and don't mind waiting longer.
# It only starts when it's actually needed, so it costs nothing while idle.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://127.0.0.1:11434

# Keeping the local model light on the PC (all optional):
OLLAMA_THREADS=          # CPU threads; blank = leave some cores free for you
OLLAMA_NUM_CTX=2048      # context size; smaller = less memory and less work
OLLAMA_NUM_PREDICT=256   # max reply length (answers are spoken, so short)
OLLAMA_KEEP_ALIVE=5m     # how long it stays in RAM after you stop talking

# ---- Conversation memory ----
# Jarvis remembers what was said — across a switch of brain, and across
# restarts — in jarvis.history.jsonl next to this file. Nothing is uploaded.
MEMORY_ENABLED=1   # set to 0 to start every session with a blank slate
MEMORY_TURNS=6     # past exchanges replayed to the local model
# Say "remember that ..." and it's kept for good in jarvis.facts.json. These
# ride along with every question, so they're capped by size, not just count.
MEMORY_MAX_FACTS=12
MEMORY_FACTS_CHARS=400

# ---- Speech recognition ----
# The accent model. en-IN understands South Asian English much better than the
# en-US default, and is the biggest single fix for Jarvis mishearing you.
# Try en-US or en-GB if en-IN gets your words wrong — it varies by speaker,
# and `python calibrate_mic.py` transcribes you in all three so you can pick.
STT_LANGUAGE=en-IN
STT_PAUSE=1.0        # seconds of silence that mean you've finished talking
STT_CALIBRATE=1.5    # seconds spent learning the room's noise at startup
# How loud counts as speech. 0 = measure the room at startup and guess, which
# is unreliable on a phone-as-mic: the same mic here measured 18 one minute and
# 1161 the next, and too high a value throws your voice away as silence.
# Run `python calibrate_mic.py` to measure your actual voice and set this once.
STT_ENERGY=0

# ---- Paid brain (keep for later) ----
# Anthropic Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# ---- Personality ----
ASSISTANT_NAME=Vondo
USER_TITLE=sir

# ---- Listening ----
# wake = only respond after the wake word | continuous = respond to everything
LISTEN_MODE=wake
WAKE_WORD=hey vondo

# ---- Voice ----
# Substring of a Windows voice name (e.g. David, Zira). Blank = system default.
TTS_VOICE=
TTS_RATE=175
